# Dissector API
# 支持单个URL: http://localhost:8000
# 支持端口范围: http://192.168.13.1:8001-8004 (会自动扩展到8001,8002,8003,8004)
# 支持多个URL（逗号分隔）: http://localhost:8001,http://localhost:8002
DISSECTOR_API=http://192.168.13.1:8001-8004

# Revelation API
# 支持单个URL: http://localhost:5000
# 支持端口范围: http://192.168.13.1:5001-5004 (会自动扩展到5001,5002,5003,5004)
# 支持多个URL（逗号分隔）: http://localhost:5001,http://localhost:5002
REVELATION_API=http://192.168.13.1:5001-5004

